# Copy to .env and fill in. Never commit .env.

# --- Warehouse ---
DUCKDB_PATH=data/warehouse/harga_pangan.duckdb

# --- Ingestion ---
# Source mode: auto (try public API, fallback to sample CSV), api, or sample
FOOD_PRICE_SOURCE_MODE=auto
# Optional public endpoint override (defaults to Panel Harga Badan Pangan Nasional)
FOOD_PRICE_SOURCE_URL=https://api-panelhargav2.badanpangan.go.id/api/front/harga-pangan-informasi
SAMPLE_CSV_PATH=data/sample/harga_pangan_sample.csv
# Number of retry attempts for HTTP fetches
INGEST_MAX_RETRIES=3
# Backoff base in seconds (exponential)
INGEST_BACKOFF_SECONDS=1.0
# HTTP request timeout in seconds
INGEST_TIMEOUT_SECONDS=10.0

# --- Optional alerting (leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Logging ---
LOG_LEVEL=INFO
